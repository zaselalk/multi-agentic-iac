# Copy this file to .env (repo root) and fill in what you need.
# .env is gitignored (see *.env in .gitignore) - never commit real values.
# Loaded automatically by evaluation/eval.py and retriever/llama_index_retriever.py
# via python-dotenv. Anything left unset here still falls back to an
# interactive prompt when the pipeline actually needs it.

# --- AWS (terraform plan / OPA verification step) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ROLE_NAME=default

# --- OpenAI (-m gpt3.5 / gpt4 / gpt5) ---
OPENAI_API_KEY=

# --- Google Gemini (-m gemini-1.0-pro / gemini-2.5-pro / gemini-2.0-flash) ---
GOOGLE_API_KEY=

# --- Replicate (-m codellama-*, Wizardcoder*) ---
REPLICATE_API_TOKEN=

# --- AWS SageMaker (-m Magicoder_S_CL_7B) ---
MAGICODER_SAGEMAKER_ENDPOINT=

# --- Azure AI Foundry ---
# One endpoint + key for everything: generation (-m foundry:<deployment-name>)
# and the RAG retriever (-e RAG / -e multi-agent), which additionally needs
# its own embedding + chat deployment names. See retriever/README.md#auth.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_EMBEDDING_MODEL=text-embedding-3-large
AZURE_AI_FOUNDRY_RETRIEVER_MODEL=gpt-4.1-mini
