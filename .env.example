# Copy this file to .env (repo root) and fill in what you need.
# .env is gitignored (see *.env in .gitignore) - never commit real values.
# Loaded automatically by orchestrator/llm.py via python-dotenv. Anything left
# unset here still falls back to an interactive prompt at startup.

# --- Azure AI Foundry (the only model provider) -----------------------------
# Must be the *model inference* endpoint, ending in /models - not the project
# endpoint under /api/projects/. orchestrator/llm.py fails fast on both
# mistakes rather than letting the SDK return a cryptic 400 or 404.
AZURE_AI_FOUNDRY_ENDPOINT=https://<resource-name>.services.ai.azure.com/models
AZURE_AI_FOUNDRY_API_KEY=
# Optional. The azure-ai-inference SDK defaults to api-version=2024-05-01-preview,
# which some Foundry deployments (notably Azure-OpenAI-family models) reject
# with "API version not supported". Set this to override it, e.g. 2024-06-01.
AZURE_AI_FOUNDRY_API_VERSION=

# --- Orchestrator -----------------------------------------------------------
# All optional; defaults shown. See orchestrator/README.md.
# VISOR_AGENT_MODEL=gpt-4.1-mini      Foundry deployment name for the Architect
# VISOR_MCP_SERVER=../mcp-server      path to the mcp-server checkout
# VISOR_POLICY_DIR=./policies         where the Security Prover reads .rego from
# VISOR_MAX_TOOL_ROUNDS=12            tool-call rounds per agent turn
# VISOR_MAX_REPAIRS=2                 repair attempts K per turn (Algorithm 1)
# VISOR_DEPLOY_VALIDATION=0           run terraform validate on every chat turn
# VISOR_CORS_ORIGINS=http://localhost:3000
# VISOR_PROJECT_DIR=../.visor/projects

# --- AWS --------------------------------------------------------------------
# Not needed for anything the system does today: the compiler is deterministic,
# terraform validate runs with -backend=false, and nothing is ever applied.
# Required only once the deploy validator grows `terraform plan` - see
# docs/RESEARCH-GAPS.md#g4.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
